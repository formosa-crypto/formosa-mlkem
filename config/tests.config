args   = -pragmas +Circuit:timing -I JazzEC:code/jasmin/768/avx2/extraction

[test-mlkem_correctness_1024_avx2]
okdirs = !proof/correctness/avx2/1024 !proof/correctness/avx2/common
args   = -pragmas +Circuit:timing -I JazzEC:code/jasmin/1024/avx2/extraction

[test-mlkem_safety_768_avx2]
