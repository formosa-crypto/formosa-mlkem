[general]
timeout = 30

provers = CVC5@1.2
provers = Z3@4.8

spec = proof/eclib/specs/avx2.spec

# Explicit per-folder includes (NOT recursive `rdirs = proof`): the recursive form
# pulled BOTH variant dirs (768/ and 1024/) onto one path, clashing on `kvec_val`
# (MLKEM768_prelude: kvec=3 vs MLKEM1024_prelude: kvec=4). The variant dirs are built
# via their own per-variant easycrypt.project; the root path carries only common code.
idirs = proof/eclib
idirs = proof/correctness/avx2/common
idirs = proof/safety
idirs = proof/security

rdirs = Jasmin:jasmin/eclib

idirs = Keccak:formosa-keccak/proof/amd64/common
idirs = Keccak:formosa-keccak/proof/amd64/ref
idirs = Keccak:formosa-keccak/proof/amd64/avx2
idirs = JazzEC:formosa-keccak/proof/amd64/extracted


idirs = CryptoSpecs:formosa-keccak/submodules/crypto-specs/common
rdirs = CryptoSpecs:formosa-keccak/submodules/crypto-specs/fips202

idirs = Spec:proof/spec
idirs = Spec:proof/spec/properties

idirs = JazzEC:proof/arrays

# Clone-based circuit bindings (mldsa-style): per-size XWord*/XArray* theories
# that clone CircuitBindings. Variant-independent, so safe on the root path.
# Non-namespaced so consumers/cross-requires use bare `require import XWordN`.
idirs = proof/xwords
idirs = proof/xarrays

# The mlkem extraction (jkem_avx2.ec, same filename per variant) is NOT on the
# root path — each variant is injected via `args = -I JazzEC:.../<v>/.../extraction`
# in config/tests.config, so the two same-named files never clash.
