#[safety={requires="is_arr_init(ap, 0, MLKEM_POLYBYTES)",
  ensures="is_arr_init(rp, 0, 16 * 32)"}]
fn _i_poly_frombytes (reg mut ptr u16[MLKEM_N] rp,
                     reg const ptr u8[MLKEM_POLYBYTES] ap) -> (reg mut ptr u16[MLKEM_N]) {
  reg u256 mask;
