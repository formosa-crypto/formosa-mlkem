  reg u256 ac0;
  reg u256 ac1;
  #[inline]
  ac0, ac1 = __wmul_16u16(are, bre);
  reg u256 ad0;
  reg u256 ad1;
  #[inline]
  ad0, ad1 = __wmul_16u16(are, bim);
  reg u256 bc0;
  reg u256 bc1;
  #[inline]
  bc0, bc1 = __wmul_16u16(aim, bre);
  reg u256 zbd0;
  reg u256 zbd1;
  #[inline]
  zbd0, zbd1 = __wmul_16u16(zaim, bim);
