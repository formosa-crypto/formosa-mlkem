inline
fn _i_poly_compress (reg mut ptr u8[MLKEM_POLYCOMPRESSEDBYTES] rp,
                    reg mut ptr u16[MLKEM_N] a) -> (reg mut ptr u8[MLKEM_POLYCOMPRESSEDBYTES],
                                                   reg mut ptr u16[MLKEM_N]) {
  a = _poly_csubq(a);
  reg u256 v;
