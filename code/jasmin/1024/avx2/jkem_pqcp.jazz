  x0, x1 = __w256_deinterleave_u16(_zero, x0, x1);
  #[inline]
  y0, y1 = __w256_deinterleave_u16(_zero, y0, y1);
  #[inline]
  x0 = __mont_red(x0, x1, qx16, qinvx16);
  #[inline]
  y0 = __mont_red(y0, y1, qx16, qinvx16);
  return x0, y0;
}

