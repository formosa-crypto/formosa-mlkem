inline
fn __w256_interleave_u16 (reg u256 al, reg u256 ah) -> (reg u256, reg u256) {
  reg u256 a0;
  a0 = #VPUNPCKL_16u16(al, ah);
  reg u256 a1;
  a1 = #VPUNPCKH_16u16(al, ah);
  return a0, a1;
}

inline
fn __w256_deinterleave_u16 (reg u256 _zero, reg u256 a0, reg u256 a1) -> 
(reg u256, reg u256) {
  reg u256 al;
