#[safety={requires="is_arr_init(seed, 0, MLKEM_SYMBYTES)",
  ensures="is_arr_init(rp, 0, MLKEM_N * 2)"}]
fn _poly_getnoise_eta2 (#[spill_to_mmx] reg mut ptr u16[MLKEM_N] rp,
