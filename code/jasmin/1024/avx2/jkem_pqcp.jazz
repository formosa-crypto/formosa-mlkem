    reg u256 t1;
    t1 = ap.[#unaligned :u256 192 * i + 32]; /* u256 */
    reg u256 t2;
    t2 = ap.[#unaligned :u256 192 * i + 64]; /* u256 */
    reg u256 t3;
    t3 = ap.[#unaligned :u256 192 * i + 96]; /* u256 */
    reg u256 t4;
    t4 = ap.[#unaligned :u256 192 * i + 128]; /* u256 */
    reg u256 t5;
    t5 = ap.[#unaligned :u256 192 * i + 160]; /* u256 */
