inline
fn __schoolbook16x (reg u256 are, reg u256 aim, reg u256 bre, reg u256 bim,
                   reg u256 zeta, reg u256 zetaqinv, reg u256 qx16,
                   reg u256 qinvx16, inline int sign) -> (reg u256, reg u256) {
  reg u256 zaim;
