fn _i_poly_tomsg (reg mut ptr u8[MLKEM_INDCPA_MSGBYTES] rp,
                 reg mut ptr u16[MLKEM_N] a) -> (reg mut ptr u8[MLKEM_INDCPA_MSGBYTES],
                                                reg mut ptr u16[MLKEM_N]) {
