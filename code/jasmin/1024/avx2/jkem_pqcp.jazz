    reg u256 a;
    a = rp.[#unaligned :u256 32 * i]; /* u256 */
    reg u256 b;
    b = bp.[#unaligned :u256 32 * i]; /* u256 */
    reg u256 r;
    r = #VPADD_16u16(a, b);
    rp.[#unaligned :u256 32 * i] = r; /* u256 */
  }
  return rp;
}

fn _poly_csubq (reg mut ptr u16[MLKEM_N] rp) -> (reg mut ptr u16[MLKEM_N]) {
